# 复制此文件为 .env.local 并填入你自己的 Supabase 项目信息
# Copy this file to .env.local and fill in your own Supabase project values

# Supabase 项目 URL（在 Supabase Console → Project Settings → API 中查找）
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase 匿名公钥（anon/public key，在同一页面中查找）
VITE_SUPABASE_ANON_KEY=your-anon-key-here
